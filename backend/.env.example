APP_NAME=AI Food Concierge
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (docker-compose service name "postgres" when run via Docker)
DATABASE_URL=postgresql+psycopg://concierge:concierge@localhost:5432/food_concierge

# Redis (optional — falls back to in-process rate limiting if unset)
REDIS_URL=redis://localhost:6379/0

# LLM provider: "gemini" | "ollama" | "mock"
# "mock" (default) needs no credentials and is what CI/tests use.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2

EMBEDDING_DIM=384
RANKING_WEIGHT_CONSTRAINT_MATCH=0.35
RANKING_WEIGHT_SEMANTIC=0.20
RANKING_WEIGHT_RATING=0.20
RANKING_WEIGHT_PRICE_FIT=0.15
RANKING_WEIGHT_CUISINE_MATCH=0.10

RATE_LIMIT_REQUESTS_PER_MINUTE=60
